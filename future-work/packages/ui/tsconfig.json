{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM"],
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx"
	},
	"include": ["src/**/*.ts"]
}
