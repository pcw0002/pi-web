{
	"id": "demo-mailbox",
	"name": "Demo",
	"version": "0.2.0",
	"description": "Sample plugin: demonstrates a pi-web-ui optional UI component with a server entry + client view + two-way messaging",
	"settings": [
		{
			"key": "pollSec",
			"type": "number",
			"label": "Poll interval (seconds)",
			"default": 60,
			"min": 10,
			"max": 600,
			"hint": "Interval for checking new mail"
		},
		{
			"key": "notifyEnabled",
			"type": "boolean",
			"label": "New-mail notifications",
			"default": true
		},
		{
			"key": "theme",
			"type": "select",
			"label": "UI theme",
			"default": "dark",
			"options": [
				"dark",
				"light"
			],
			"hint": "demo of a select field"
		}
	]
}
